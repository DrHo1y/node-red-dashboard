        "y": 120,
        "wires": [
            [
                "fb-ex2-debug"
            ]
        ]
    },
    {
        "id": "fb-ex2-debug",
        "type": "debug",
        "z": "fb-ex2-tab",
        "name": "submitted",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 820,
        "y": 120,
        "wires": []
    },
    {
        "id": "fb-ex2-func",
        "type": "function",
        "z": "fb-ex2-tab",
        "name": "schema by topic",
        "func": "// pick a schema by msg.topic and send it to the form builder\nconst schemas = {\"bug\": [{\"type\": \"text\", \"key\": \"title\", \"label\": \"Title\", \"required\": true, \"minLength\": 5}, {\"type\": \"select\", \"key\": \"severity\", \"label\": \"Severity\", \"options\": [{\"label\": \"Low\", \"value\": \"low\"}, {\"label\": \"High\", \"value\": \"high\"}], \"default\": \"low\", \"cols\": 6}, {\"type\": \"text\", \"key\": \"version\", \"label\": \"Version\", \"pattern\": \"^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$\", \"patternMessage\": \"Use x.y.z\", \"cols\": 6}, {\"type\": \"textarea\", \"key\": \"steps\", \"label\": \"Steps to reproduce\", \"rows\": 3}], \"feedback\": [{\"type\": \"text\", \"key\": \"name\", \"label\": \"Your name\"}, {\"type\": \"number\", \"key\": \"rating\", \"label\": \"Rating 1-5\", \"min\": 1, \"max\": 5, \"default\": 5, \"required\": true}, {\"type\": \"switch\", \"key\": \"contactMe\", \"label\": \"Contact me\"}, {\"type\": \"color\", \"key\": \"favColor\", \"label\": \"Favourite colour\", \"default\": \"#0094ce\"}]};\nmsg.schema = schemas[msg.topic];\nmsg.ui_update = { label: msg.topic === 'bug' ? 'Bug report' : 'Feedback' };\nmsg.payload = msg.topic === 'bug' ? { version: '{{appVersion}}' } : { name: '{{user}}' };\nmsg.vars = { appVersion: '1.34.0', user: 'Dr. Holy' };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "fb-ex2-form"
            ]
        ]
    },
    {
        "id": "fb-ex2-btns",
        "type": "ui-button-group",
        "z": "fb-ex2-tab",
        "name": "",
        "group": "fb-ex2-group",
        "order": 0,
        "width": 0,
        "height": 0,
        "label": "Form type",
        "className": "",
        "rounded": true,
        "useThemeColors": true,
        "passthru": false,
        "options": [
            {
                "label": "Bug report",
                "icon": "bug",
                "value": "bug",
                "valueType": "str",
                "color": "#009933"
            },
            {
                "label": "Feedback",
                "icon": "star",
                "value": "feedback",
                "valueType": "str",
                "color": "#999999"
            }
        ],
        "topic": "topic",
