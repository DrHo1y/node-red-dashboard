        "name": "Dynamic form",
        "label": "Choose a form",
        "order": 1,
        "width": 0,
        "height": 0,
        "schema": "[]",
        "templates": "[]",
        "vars": "{}",
        "outputTemplate": "",
        "allowEdit": true,
        "allowTemplates": true,
        "resetOnSubmit": true,
        "contextStore": "",
        "submit": "Send",
        "cancel": "",
